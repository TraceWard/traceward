# TraceWard loads this checkout's .env automatically. Never commit real tokens.
# Existing process environment takes precedence. These settings are observer-only.
TRACEWARD_JUDGE_PROVIDER=lmstudio
TRACEWARD_JUDGE_URL=http://127.0.0.1:1234/v1/chat/completions
TRACEWARD_JUDGE_MODEL=qwen/qwen3.8-27b
LMSTUDIO_API_KEY=

# To use OpenRouter, set TRACEWARD_JUDGE_PROVIDER=openrouter and set
# TRACEWARD_JUDGE_MODEL to your concrete OpenRouter model ID.
# TRACEWARD_JUDGE_URL applies only to LM Studio.
OPENROUTER_KEY=

# Legacy optional LM Studio credential alias; LMSTUDIO_API_KEY takes precedence.
TRACEWARD_JUDGE_TOKEN=
