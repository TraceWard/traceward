+
+// tracewardDeleteAt records immutable kernel-consumed arguments and observes
+// the result without using a sink's return value to change syscall behaviour.
+func tracewardDeleteAt(t *kernel.Task, sysno uintptr, dirfd int32, addr hostarch.Addr, flags int32, directory bool) (err error) {
+    var event *pb.FileDelete
+    var fields seccheck.FieldSet
+    if seccheck.Global.Enabled(seccheck.PointFileDelete) {
+        fields = seccheck.Global.GetFieldSet(seccheck.PointFileDelete)
+        ctx := &pb.ContextData{}
+        kernel.LoadSeccheckData(t, fields.Context, ctx)
+        event = &pb.FileDelete{ContextData: ctx, Sysno: uint64(sysno), Dirfd: int64(dirfd), Flags: uint32(flags), Directory: directory}
+        defer func() {
+            event.Exit = &pb.Exit{}
+            if err != nil {
+                event.Exit.Result = -1
+                event.Exit.Errorno = int64(kernel.ExtractErrno(err, int(sysno)))
+            }
+            seccheck.Global.SentToSinks(func(sink seccheck.Sink) error {
+                return sink.Syscall(t, fields, ctx, pb.MessageType_MESSAGE_SENTRY_FILE_DELETE, event)
+            })
+        }()
+    }
+    if flags & ^linux.AT_REMOVEDIR != 0 {
+        if event != nil { event.PathError = "invalid deletion flags" }
+        return linuxerr.EINVAL
+    }
+    path, err := copyInPath(t, addr)
+    if err != nil {
+        if event != nil { event.PathError = "pathname unavailable" }
+        return err
+    }
+    if event != nil { event.Pathname = path.String() }
+    tpop, err := getTaskPathOperation(t, dirfd, path, disallowEmptyPath, nofollowFinalSymlink, 0)
+    if err != nil {
+        if event != nil { event.PathError = "start directory unavailable" }
+        return err
+    }
+    defer tpop.Release(t)
+    if event != nil {
+        base, pathErr := t.Kernel().VFS().PathnameWithDeleted(t, tpop.pop.Root, tpop.pop.Start)
+        if pathErr == nil { event.StartPath = base } else { event.PathError = "start directory path unresolved" }
+    }
+    if directory { return t.Kernel().VFS().RmdirAt(t, t.Credentials(), &tpop.pop) }
+    return t.Kernel().VFS().UnlinkAt(t, t.Credentials(), &tpop.pop)
 }
 
